datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// STAFF ACCESS CONTROL (MILESTONE 2)
// -------------------------------------------------------------
enum UserRole {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  LAB_STAFF
  BILLING_STAFF
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  passwordHash         String
  fullName             String
  phone                String?
  role                 UserRole          @default(RECEPTIONIST)
  isActive             Boolean           @default(true)
  lastLoginAt          DateTime?
  doctorId             String?           @unique
  doctor               Doctor?           @relation(fields: [doctorId], references: [id])
  vitalRecords         VitalRecord[]
  createdAuditLogs     AuditLog[]
  labOrders            DiagnosticOrder[] @relation("AssignedLabStaff")
  createdPrescriptions Prescription[]    @relation("DoctorPrescriptions")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@map("users")
}

// -------------------------------------------------------------
// PATIENT ONLINE LOGIN ACCOUNT (MILESTONE 3)
// -------------------------------------------------------------
model PatientAccount {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String
  dob          DateTime
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(true)
  lastLoginAt  DateTime?

  // Link to electronic clinic patient file
  linkedPatientId String?  @unique
  linkedPatient   Patient? @relation(fields: [linkedPatientId], references: [id])

  notifications       PatientNotification[]
  supportRequests     PatientSupportRequest[]
  paymentTransactions PaymentTransaction[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([email])
  @@index([phone])
  @@map("patient_accounts")
}

model PatientNotification {
  id               String         @id @default(uuid())
  patientAccountId String
  patientAccount   PatientAccount @relation(fields: [patientAccountId], references: [id], onDelete: Cascade)
  title            String
  message          String
  category         String         @default("SYSTEM") // APPOINTMENT, CLINICAL, BILLING, SYSTEM
  isRead           Boolean        @default(false)
  linkUrl          String?
  createdAt        DateTime       @default(now())

  @@index([patientAccountId, isRead])
  @@map("patient_notifications")
}

model PatientSupportRequest {
  id               String         @id @default(uuid())
  ticketNumber     String         @unique // e.g. SUP-2026-0001
  patientAccountId String
  patientAccount   PatientAccount @relation(fields: [patientAccountId], references: [id], onDelete: Cascade)
  subject          String
  category         String // APPOINTMENTS, MEDICAL_RECORDS, BILLING, GENERAL
  description      String
  status           String         @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  response         String?
  respondedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("patient_support_requests")
}

// -------------------------------------------------------------
// CLINIC STAFF & SERVICES
// -------------------------------------------------------------
model Doctor {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  qualification       String
  specialty           String
  experienceYears     Int?
  biography           String
  areasOfExpertise    String[]             @default([])
  profileImage        String?
  isActive            Boolean              @default(true)
  user                User?
  appointmentRequests AppointmentRequest[]
  appointments        Appointment[]
  consultations       Consultation[]
  diagnosticOrders    DiagnosticOrder[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("doctors")
}

model Service {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  description         String
  benefits            String?
  whatToExpect        String?
  category            String?
  standardFee         Decimal              @default(50.00) @db.Decimal(10, 2)
  isActive            Boolean              @default(true)
  appointmentRequests AppointmentRequest[]
  appointments        Appointment[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("services")
}

// -------------------------------------------------------------
// PATIENT MANAGEMENT
// -------------------------------------------------------------
model Patient {
  id                    String   @id @default(uuid())
  patientId             String   @unique // e.g. PAT-10029
  fullName              String
  dob                   DateTime
  gender                String   @default("Female")
  bloodGroup            String?
  phone                 String
  email                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // Clinical background
  allergies          String[] @default([])
  medicalConditions  String[] @default([])
  currentMedications String[] @default([])
  medicalHistory     String?
  menstrualHistory   String?
  pregnancyHistory   String?
  previousSurgeries  String?

  account          PatientAccount?
  appointments     Appointment[]
  vitalRecords     VitalRecord[]
  consultations    Consultation[]
  prescriptions    Prescription[]
  diagnosticOrders DiagnosticOrder[]
  invoices         Invoice[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([phone])
  @@index([patientId])
  @@map("patients")
}

// -------------------------------------------------------------
// APPOINTMENTS
// -------------------------------------------------------------
enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

model AppointmentRequest {
  id                   String            @id @default(uuid())
  referenceId          String            @unique
  patientName          String
  email                String
  phone                String
  serviceId            String
  service              Service           @relation(fields: [serviceId], references: [id])
  preferredDoctorId    String?
  preferredDoctor      Doctor?           @relation(fields: [preferredDoctorId], references: [id])
  preferredDate        DateTime
  preferredTime        String?
  reason               String?
  status               AppointmentStatus @default(REQUESTED)
  consent              Boolean           @default(false)
  convertedAppointment Appointment?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@map("appointment_requests")
}

model Appointment {
  id                   String              @id @default(uuid())
  appointmentNumber    String              @unique // e.g. APT-2026-0001
  patientId            String
  patient              Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId             String
  doctor               Doctor              @relation(fields: [doctorId], references: [id])
  serviceId            String
  service              Service             @relation(fields: [serviceId], references: [id])
  scheduledDate        DateTime
  scheduledTimeSlot    String // e.g. "10:30 AM"
  status               AppointmentStatus   @default(CONFIRMED)
  type                 String              @default("CONSULTATION") // CONSULTATION, FOLLOW_UP, WALK_IN
  reason               String?
  cancellationReason   String?
  appointmentRequestId String?             @unique
  appointmentRequest   AppointmentRequest? @relation(fields: [appointmentRequestId], references: [id])

  vitalRecords VitalRecord[]
  consultation Consultation?
  invoices     Invoice[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([scheduledDate])
  @@index([doctorId, scheduledDate])
  @@map("appointments")
}

// -------------------------------------------------------------
// NURSING & VITALS
// -------------------------------------------------------------
model VitalRecord {
  id            String       @id @default(uuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  recordedById  String
  recordedBy    User         @relation(fields: [recordedById], references: [id])

  systolicBP      Int? // mmHg
  diastolicBP     Int? // mmHg
  heartRate       Int? // bpm
  temperature     Decimal? @db.Decimal(4, 1) // °C
  respiratoryRate Int? // breaths/min
  spO2            Int? // %
  weightKg        Decimal? @db.Decimal(5, 2)
  heightCm        Decimal? @db.Decimal(5, 1)
  bmi             Decimal? @db.Decimal(4, 1)
  nursingNotes    String?
  recordedAt      DateTime @default(now())

  @@map("vital_records")
}

// -------------------------------------------------------------
// CLINICAL CONSULTATIONS & EMR
// -------------------------------------------------------------
enum ConsultationStatus {
  DRAFT
  SIGNED
  COMPLETED
}

model Consultation {
  id                 String      @id @default(uuid())
  consultationNumber String      @unique // e.g. CON-2026-0001
  appointmentId      String      @unique
  appointment        Appointment @relation(fields: [appointmentId], references: [id])
  patientId          String
  patient            Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             Doctor      @relation(fields: [doctorId], references: [id])

  chiefComplaint   String
  symptoms         String?
  clinicalFindings String?
  diagnosis        String
  treatmentPlan    String

  specialtyType    String? // GYNECOLOGY, OBSTETRICS_ANTENATAL, PCOS, MENOPAUSE, FERTILITY
  specialtyDetails Json?

  status              ConsultationStatus @default(DRAFT)
  isReleasedToPatient Boolean            @default(true) // Milestone 3 release approval flag
  followUpDate        DateTime?
  followUpNotes       String?
  signedAt            DateTime?

  prescriptions    Prescription[]
  diagnosticOrders DiagnosticOrder[]
  amendments       ConsultationAmendment[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@map("consultations")
}

model ConsultationAmendment {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  amendedById    String
  reason         String
  previousData   Json
  amendedData    Json
  createdAt      DateTime     @default(now())

  @@map("consultation_amendments")
}

// -------------------------------------------------------------
// PRESCRIPTIONS
// -------------------------------------------------------------
enum PrescriptionStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

model Prescription {
  id                  String             @id @default(uuid())
  prescriptionNumber  String             @unique // e.g. RX-2026-0001
  patientId           String
  patient             Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId            String
  doctor              User               @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  consultationId      String?
  consultation        Consultation?      @relation(fields: [consultationId], references: [id])
  status              PrescriptionStatus @default(FINALIZED)
  isReleasedToPatient Boolean            @default(true)
  clinicalNotes       String?
  items               PrescriptionItem[]
  issuedAt            DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationName String
  dosage         String // e.g. "500 mg"
  frequency      String // e.g. "Twice daily after meals"
  duration       String // e.g. "5 days"
  instructions   String?
  createdAt      DateTime     @default(now())

  @@map("prescription_items")
}

// -------------------------------------------------------------
// DIAGNOSTIC & LAB ORDERS
// -------------------------------------------------------------
enum DiagnosticStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  REVIEWED
  CANCELLED
}

model DiagnosticOrder {
  id                 String        @id @default(uuid())
  orderNumber        String        @unique // e.g. LAB-2026-0001
  patientId          String
  patient            Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  orderingDoctorId   String
  orderingDoctor     Doctor        @relation(fields: [orderingDoctorId], references: [id])
  consultationId     String?
  consultation       Consultation? @relation(fields: [consultationId], references: [id])
  assignedLabStaffId String?
  assignedLabStaff   User?         @relation("AssignedLabStaff", fields: [assignedLabStaffId], references: [id])

  testName            String // e.g. "Pelvic Ultrasound", "Complete Blood Count", "Hormone Panel"
  testCategory        String // IMAGING, PATHOLOGY, ENDOCRINE, CYTOLOGY
  status              DiagnosticStatus @default(ORDERED)
  isReleasedToPatient Boolean          @default(true) // Milestone 3: visible to patient after clinician approval
  sampleCollectedAt   DateTime?
  resultsNotes        String?
  reportUrl           String?
  standardPrice       Decimal          @default(45.00) @db.Decimal(10, 2)
  isReviewed          Boolean          @default(false)
  reviewedAt          DateTime?
  orderedAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("diagnostic_orders")
}

// -------------------------------------------------------------
// BILLING, INVOICES & PAYMENTS
// -------------------------------------------------------------
enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  INSURANCE
  BANK_TRANSFER
  ONLINE_GATEWAY
}

model Invoice {
  id            String       @id @default(uuid())
  invoiceNumber String       @unique // e.g. INV-2026-0001
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  subtotal   Decimal       @db.Decimal(10, 2)
  discount   Decimal       @default(0.00) @db.Decimal(10, 2)
  tax        Decimal       @default(0.00) @db.Decimal(10, 2)
  total      Decimal       @db.Decimal(10, 2)
  paidAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  balance    Decimal       @db.Decimal(10, 2)
  status     InvoiceStatus @default(PENDING)
  dueDate    DateTime?

  items        InvoiceItem[]
  payments     Payment[]
  transactions PaymentTransaction[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@map("invoice_items")
}

model Payment {
  id             String        @id @default(uuid())
  receiptNumber  String        @unique // e.g. REC-2026-0001
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @default(CARD)
  transactionRef String?
  receivedBy     String?
  notes          String?
  paidAt         DateTime      @default(now())

  @@map("payments")
}

model PaymentTransaction {
  id               String         @id @default(uuid())
  orderId          String         @unique // e.g. order_Kj29aL81b9
  paymentId        String?        @unique // Gateway reference e.g. pay_L189211
  signature        String?
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @default("INR")
  status           String         @default("CREATED") // CREATED, SUCCESS, FAILED, REFUNDED
  invoiceId        String
  invoice          Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patientAccountId String
  patientAccount   PatientAccount @relation(fields: [patientAccountId], references: [id], onDelete: Cascade)
  gatewayResponse  Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("payment_transactions")
}

// -------------------------------------------------------------
// AUDIT LOGGING
// -------------------------------------------------------------
model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userRole     String?
  action       String // CREATE, UPDATE, SIGN, DELETE, LOGIN, PAYMENT, RELEASE
  resourceType String // PATIENT, CONSULTATION, PRESCRIPTION, INVOICE, APPOINTMENT, AUTH
  resourceId   String?
  details      Json?
  ipAddress    String?
  timestamp    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([timestamp])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// PUBLIC WEBSITE MODELS (MILESTONE 1)
// -------------------------------------------------------------
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  consent   Boolean  @default(false)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model Article {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  excerpt       String
  content       String
  category      String
  featuredImage String?
  readTime      String?
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("articles")
}
